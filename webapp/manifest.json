{
  "_version": "1.73.1",
  "sap.app": {
    "id": "zflightbootcamp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.19.3",
      "toolsId": "6e8bb7fa-fde0-4015-9d67-a1f045c3bd44"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_flight_bootcamp_o4/srvd/sap/zui_flight_bootcamp_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zrap100_kristi-display": {
          "semanticObject": "zrap100_kristi",
          "action": "display",
          "title": "{{zrap100_kristi-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zflightbootcamp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_FLIGHT_BOOTCAMPList",
          "target": "ZC_FLIGHT_BOOTCAMPList"
        },
        {
          "pattern": "ZC_FLIGHT_BOOTCAMP({key}):?query:",
          "name": "ZC_FLIGHT_BOOTCAMPObjectPage",
          "target": "ZC_FLIGHT_BOOTCAMPObjectPage"
        },
        {
          "pattern": "ZC_FLIGHT_BOOTCAMP({key})/_detailsKR({key2}):?query:",
          "name": "FlightDetailsKRObjectPage",
          "target": "FlightDetailsKRObjectPage"
        }
      ],
      "targets": {
        "ZC_FLIGHT_BOOTCAMPList": {
          "type": "Component",
          "id": "ZC_FLIGHT_BOOTCAMPList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_FLIGHT_BOOTCAMP",
              "variantManagement": "Page",
              "navigation": {
                "ZC_FLIGHT_BOOTCAMP": {
                  "detail": {
                    "route": "ZC_FLIGHT_BOOTCAMPObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ZC_FLIGHT_BOOTCAMPObjectPage": {
          "type": "Component",
          "id": "ZC_FLIGHT_BOOTCAMPObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_FLIGHT_BOOTCAMP",
              "navigation": {
                "_detailsKR": {
                  "detail": {
                    "route": "FlightDetailsKRObjectPage"
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "GeoMap": {
                      "template": "zflightbootcamp.ext.fragment.GeoMap",
                      "position": {
                        "placement": "After",
                        "anchor": "GeneralInfo"
                      },
                      "title": "{i18n>itinerary}"
                    }
                  }
                },
                "header": {
                  "actions": {
                    "gotoweb": {
                      "press": "zflightbootcamp.ext.controller.CustomHandler.gotoweb",
                      "visible": true,
                      "enabled": true,
                      "text": "Go to Web"
                    }
                  }
                }
              }
            }
          }
        },
        "FlightDetailsKRObjectPage": {
          "type": "Component",
          "id": "FlightDetailsKRObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_FLIGHT_BOOTCAMP/_detailsKR"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
